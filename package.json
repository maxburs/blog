{
  "name": "maxwell-bursons-blog",
  "type": "module",
  "description": "Blog of Maxwell Burson",
  "version": "1.0.0",
  "author": "Maxwell Burson <maxwellburson@gmail.com>",
  "bugs": {
    "url": "https://github.com/maxburs/blog/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "homepage": "https://maxburson.com",
  "license": "MIT",
  "main": "n/a",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxburson/blog.git"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "yarn generateFeeds && vite build",
    "preview": "vite preview",
    "format": "prettier --write --ignore-unknown .",
    "typecheck": "tsc",
    "generateFeeds": "node --import @swc-node/register/esm-register ./scripts/generate-feeds.ts",
    "prepare": "husky"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown "
  },
  "dependencies": {
    "@solidjs/web": "2.0.2",
    "@tanstack/solid-router": "2.0.0-rc.10",
    "@tanstack/solid-start": "2.0.0-rc.10",
    "gray-matter": "4.0.2",
    "normalize.css": "^8.0.1",
    "prismjs": "^1.25.0",
    "remark": "15",
    "remark-gfm": "^4.0.0",
    "remark-html": "16",
    "sass": "^1.79.4",
    "solid-js": "2.0.2",
    "typescript": "latest"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "^3.0.1",
    "@swc-node/register": "^1.10.9",
    "@swc/core": "^1.7.26",
    "@swc/types": "^0.1.12",
    "@types/jest": "^25.2.2",
    "@types/node": "22",
    "feed": "^4.2.1",
    "gatsby-remark-prismjs": "7",
    "husky": "9",
    "lint-staged": "15",
    "prettier": "3",
    "vite": "^8.3.8"
  },
  "packageManager": "yarn@4.4.0"
}
